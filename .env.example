# ── Auth0 ────────────────────────────────────────────────────────────────────
# Your Auth0 tenant domain and the M2M application that represents the agent
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-m2m-app-client-id
AUTH0_CLIENT_SECRET=***
AUTH0_MGMT_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
# Dashboard: Applications -> APIs -> Auth0 Management API -> Test tab (24h token)
AUTH0_MGMT_TOKEN=***
# Same value as AUTH0_CLIENT_ID (the agent checks its own metadata)
AUTH0_APP_ID=your-m2m-app-client-id

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=***
LANGFUSE_SECRET_KEY=***
# EU region: https://cloud.langfuse.com  |  US region: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── LLM (Vertex AI via Google ADC — run `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.7-flash

# ── App ───────────────────────────────────────────────────────────────────────
AGENT_TASK_TOPIC=enterprise agentic AI governance
# Kill switch dry-run: "true" = never actually deletes the client grant
KILLSWITCH_DRY_RUN=true
